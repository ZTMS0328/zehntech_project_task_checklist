<odoo>

    <!--Tree view for the project.checklist Model-->
    <record id="project_checklist_action_tree" model="ir.ui.view">
        <field name="name">project.checklist.action.tree</field>
        <field name="model">project.checklist</field>
        <field name="arch" type="xml">
            <list string="Project Checklist">
                <field name="name"/>
                <field name="description"/>
                <field name="checklist_category"/>
            </list>
        </field>
    </record>

    <!--Search view for the project.checklist Model-->
    <record id="project_checklist_action_search" model="ir.ui.view">
        <field name="name">project.checklist.action.search</field>
        <field name="model">project.checklist</field>
        <field name="arch" type="xml">
            <search string="Project Checklist">
                <field name="name"/>
                <field name="description"/>
                <field name="checklist_category"/>
                <filter name="groupby_checklist_category" string="Checklist Category" context="{'group_by': 'checklist_category'}"/>
            </search>
        </field>
    </record>

    <!--Form view for the project.checklist Model-->
    <record id="project_checklist_action_form" model="ir.ui.view">
        <field name="name">project.checklist.action.form</field>
        <field name="model">project.checklist</field>
        <field name="arch" type="xml">
            <form string="Project Checklist">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="checklist_category"/>
                            <!-- <field name="task_ids" invisible="1"/> -->
                        </group>
                    </group>

                    <!--For the one2many field of checklist item-->
                    <label for="checklist_ids" string="CheckList Items"/>
                    <field name="checklist_ids">
                        <list create="1">
                            <field name="sequence" widget="handle"/>
                            <field name="name" required="1"/>
                            <field name="description"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!--Form view for checklist.item Model-->
    <record id="project_checklist_item_action_form" model="ir.ui.view">
        <field name="name">project.checklist.item.action.form</field>
        <field name="model">project.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--Action for the Checklist.item Model-->
    <record id="project_checklist_item_action" model="ir.actions.act_window">
        <field name="name">Checklist Item</field>
        <field name="res_model">project.checklist.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="project_checklist_action_search"/>
    </record>

    <!--Action for the project.checklist Model-->
    <record id="project_checklist_action" model="ir.actions.act_window">
        <field name="name">Project Checklist</field>
        <field name="res_model">project.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a checklist
            </p>
        </field>
    </record>


    <!--Menu for the Project Checklist-->
    <menuitem id="project_checklist_menu" 
        name="Project Checklist" 
        action="project_checklist_action" 
        parent="checklist_menu_root" 
        />

</odoo>
