<odoo>
    <data noupdate="1">
        <!-- Sample Task Checklists1-->
        <!-- Create Task Checklist and Items Simultaneously -->

        <record id="checklist_category_sample_1" model="checklist.category">
            <field name="name">Bug Fix</field>
        </record>

        <record id="task_checklist_sample_1" model="task.checklist">
            <field name="name" >Sample Bugs Checklist</field>
            <field name="description" >This is a sample checklist for bug fix tasks.</field>
            <field name="checklist_category" ref="checklist_category_sample_1"/>
        </record>

        <!-- Define checklist items separately and link them using checklist_id -->
        <record id="checklist_item_1" model="checklist.item">
            <field name="name">Document steps</field>
            <field name="description" >Outline the steps to reproduce the bug.</field>
            <field name="checklist_id" ref="task_checklist_sample_1"/>
        </record>

        <record id="checklist_item_2" model="checklist.item">
            <field name="name" >Apply the fix</field>
            <field name="description" >Implement the fix for the bug.</field>
            <field name="checklist_id" ref="task_checklist_sample_1"/>
        </record>

        <record id="checklist_item_3" model="checklist.item">
            <field name="name">Test the fix</field>
            <field name="description" >Ensure the bug is fixed and no new issues are introduced.</field>
            <field name="checklist_id" ref="task_checklist_sample_1"/>
        </record>

       <!-- Sample Feature Request Checklist -->
        <record id="checklist_category_feature_request" model="checklist.category">
            <field name="name">Feature Request</field>
        </record>

        <!-- Define the checklist -->
        <record id="task_checklist_sample_2" model="task.checklist">
            <field name="name">Sample Feature Request Checklist</field>
            <field name="description">A checklist for managing the development of a new feature.</field>
            <field name="checklist_category" ref="checklist_category_feature_request"/>
        </record>

        <!-- Define the checklist items separately -->
        <record id="task_checklist_item_1" model="checklist.item">
            <field name="name">Define feature scope</field>
            <field name="description">Define the purpose, goals, and user requirements for the new feature.</field>
            <field name="checklist_id" ref="task_checklist_sample_2"/>
        </record>

        <record id="task_checklist_item_2" model="checklist.item">
            <field name="name">Create design mockups</field>
            <field name="description">Design the feature's user interface (UI) and create wireframes/mockups.</field>
            <field name="checklist_id" ref="task_checklist_sample_2"/>
        </record>

        <record id="task_checklist_item_3" model="checklist.item">
            <field name="name">Develop the feature</field>
            <field name="description">Implement the feature based on the defined scope and design mockups.</field>
            <field name="checklist_id" ref="task_checklist_sample_2"/>
        </record>

        <record id="task_checklist_item_4" model="checklist.item">
            <field name="name">Test the feature</field>
            <field name="description">Test the feature thoroughly to ensure it meets the defined requirements and works as expected.</field>
            <field name="checklist_id" ref="task_checklist_sample_2"/>
        </record>


        <!-- Sample Improvement Checklist -->
        <record id="checklist_category_improvement" model="checklist.category">
            <field name="name">Improvement</field>
        </record>

        <!-- Define the checklist -->
        <record id="task_checklist_sample_3" model="task.checklist">
            <field name="name">Sample Improvement Checklist</field>
            <field name="description">A checklist for addressing improvements in existing features or functionality.</field>
            <field name="checklist_category" ref="checklist_category_improvement"/>
        </record>

        <!-- Define the checklist items separately -->
        <record id="task_checklist_item_5" model="checklist.item">
            <field name="name">Identify area for improvement</field>
            <field name="description">Identify the area in the feature or process that needs improvement.</field>
            <field name="checklist_id" ref="task_checklist_sample_3"/>
        </record>

        <record id="task_checklist_item_6" model="checklist.item">
            <field name="name">Research possible solutions</field>
            <field name="description">Research different approaches to solving the identified problem or improving the process.</field>
            <field name="checklist_id" ref="task_checklist_sample_3"/>
        </record>

        <record id="task_checklist_item_7" model="checklist.item">
            <field name="name">Implement the improvement</field>
            <field name="description">Implement the chosen solution or improvement in the product or process.</field>
            <field name="checklist_id" ref="task_checklist_sample_3"/>
        </record>

        <record id="task_checklist_item_8" model="checklist.item">
            <field name="name">Test the improvement</field>
            <field name="description">Test the implemented improvement to verify that it works as intended and achieves the desired results.</field>
            <field name="checklist_id" ref="task_checklist_sample_3"/>
        </record>


